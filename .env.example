# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead.

# Server-only Google key (Places API (New) + Geocoding API). Never prefix with VITE_,
# or it would be bundled into the browser code.
GOOGLE_MAPS_API_KEY=

# Set to "mock" to use the built-in demo restaurants instead of Google.
VITE_DATA_SOURCE=
